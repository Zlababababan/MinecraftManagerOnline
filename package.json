{
  "name": "mmo",
  "version": "0.0.0",
  "private": true,
  "description": "MinecraftManagerOnline — pilotage à distance de serveurs Minecraft auto-hébergés",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run build typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:build": "node tools/release/build.mjs",
    "release:smoke": "node tools/release/smoke.mjs",
    "release:publish": "node tools/release/publish.mjs"
  },
  "devDependencies": {
    "@mmo/config": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "2.10.11"
  }
}
